# =====================================================================
#  העתק את הקובץ הזה ל-.env ומלא את הערכים.
#  הקובץ .env לא עולה לגיטהאב לעולם.
#  ההסבר המלא לכל שדה נמצא ב-README.md.
# =====================================================================

# ── הקבוצה בוואטסאפ ─────────────────────────────────────────────────
# המזהה של קבוצת הקבלות. נראה ככה: 120363012345678901@g.us
# איך משיגים אותו: מריצים  npm run groups  אחרי שסורקים את ה-QR.
# כל עוד השדה ריק — הבוט לא מעבד כלום, רק מדפיס ללוג איזו קבוצה זיהה.
RECEIPTS_GROUP_ID=

# האם לעבד רק תמונות ששלחת אתה (true) או של כל חבר בקבוצה (false).
# ברירת המחדל true — הכי בטוח: הבוט לא נוגע בתמונות של אחרים.
ONLY_FROM_ME=true

# ── בינה מלאכותית שקוראת את הקבלה ────────────────────────────────────
# מפתח חינמי מ-https://aistudio.google.com/apikey
GEMINI_API_KEY=
# שים לב: gemini-2.5-flash כבר לא נפתח למפתחות חדשים.
# חלופות עובדות: gemini-3.6-flash (מומלץ) · gemini-3.5-flash · gemini-flash-latest
GEMINI_MODEL=gemini-3.6-flash

# ── Google Sheets (הטבלה שאליה נכתבות השורות) ────────────────────────
# המזהה של הגיליון — החלק באמצע ה-URL:
# https://docs.google.com/spreadsheets/d/<זה המזהה>/edit
GOOGLE_SHEET_ID=

# שם הלשונית בתוך הגיליון. אם היא לא קיימת — הבוט ייצור אותה לבד.
GOOGLE_SHEET_TAB=הוצאות

# חשבון שירות של Google (Service Account) — ראה README שלב 3.
# חשוב: לשתף את הגיליון עם כתובת המייל הזו בהרשאת "עורך".
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# המפתח הפרטי מתוך קובץ ה-JSON. משאירים אותו בשורה אחת עם \n כמו שהוא.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# ── שמירת תמונת הקבלה (כדי שיהיה קישור בטבלה) ────────────────────────
# supabase — מומלץ. מעלה את התמונה ומקבל קישור קבוע.
# local    — שומר לתיקייה על המחשב (לא שורד הרצה בענן).
# none     — לא שומר תמונה בכלל.
STORAGE=local
RECEIPTS_DIR=./receipts

# רק אם STORAGE=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=receipts

# ── הרצה ────────────────────────────────────────────────────────────
PORT=3100
# נתיב לשמירת החיבור לוואטסאפ (בענן — תיקייה עם דיסק קבוע)
WA_SESSION_PATH=./.wwebjs_auth
# גרסת וואטסאפ ווב נעולה. אם הבוט נתקע על "אומת בהצלחה" בלולאה
# ואירוע ready לא נורה — נסה גרסה אחרת מהרשימה:
# https://github.com/wppconnect-team/wa-version/tree/main/html
WA_WEB_VERSION=2.3000.1044922618-alpha
# נתיב לזיכרון "מה כבר עובד" (מונע כפילויות אחרי הפעלה מחדש)
STATE_PATH=./.state/processed.json
# בענן: נתיב ל-Chromium המותקן במערכת
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
